# 憑證與個人設定不入版控（含 SSH 金鑰與 AI CLI 登入 token）
# 環境變數含密碼，僅入版控 .env.example 範本
.env
configs/ssh/*
!configs/ssh/.gitkeep
configs/claude.json
configs/gitconfig

# skills 目錄僅在此放行，內容取捨由各 skills/.gitignore 自治（單一控制點）
.claude/*
!.claude/.gitkeep
!.claude/CLAUDE.md
!.claude/skills
.codex/*
!.codex/.gitkeep
!.codex/AGENTS.md
!.codex/skills
.gemini/*
!.gemini/.gitkeep
!.gemini/GEMINI.md
!.gemini/skills
.config/*
!.config/.gitkeep
!.config/opencode
.config/opencode/*
!.config/opencode/AGENTS.md
!.config/opencode/skills

# 暫存檔不進git
tmp*


# 系統設定檔
.DS_Store